+extern void redwood_tl(const char *format, ...) __printflike(1, 2);
+static int touch_note(const char *format, ...) __printflike(1, 2);
+static int
+touch_note(const char *format, ...)
+{
+    char line[192];
+    va_list args;
+    va_start(args, format);
+    vsnprintf(line, sizeof(line), format, args);
+    va_end(args);
+    redwood_tl("%s", line);
+    return printf("%s", line);
+}
+/* Preserve the console log and also mirror diagnosis into the loader live log. */
+#define printf touch_note
